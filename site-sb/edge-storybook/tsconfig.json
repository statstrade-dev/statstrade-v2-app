{
  "extends": "../../tsconfig.base",
  "include": [
    "./src",
    "../ui/src",
    "./src/storybook"
  ],
  "compilerOptions": {
    "composite": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@statstrade/web-main": [
        "../../site/web-main/src/index"
      ],
      "@statstrade/web-main/*": [
        "../../site/web-main/src/*"
      ],
      "react-native": [
        "react-native-web"
      ]
    }
  }
}
