# Server-only settings; never use NEXT_PUBLIC_ for credentials.
INSTAGRAM_APP_ID=1144842521271734
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_USERNAME=statstrade.com.au
INSTAGRAM_LOGIN_CONFIG_ID=1072833352481481
INSTAGRAM_GRAPH_VERSION=v27.0
INSTAGRAM_REDIRECT_URI=https://api.statstrade.com.au/v1/integrations/instagram/oauth/callback
# Base64-encoded random 32-byte key. Preserve it after storing a connection.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# The numeric StatsTrade professional Instagram account ID, not the Meta app ID.
INSTAGRAM_ACCOUNT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Reply only to new Instagram DMs received after this activation timestamp.
# /ping => Pong! 🏓 ; /echo <text> => the supplied text.
INSTAGRAM_DM_COMMANDS_ENABLED=false
INSTAGRAM_DM_COMMANDS_SINCE=
# Non-command text and attachment DMs receive the command menu after this time.
INSTAGRAM_DM_MENU_SINCE=
