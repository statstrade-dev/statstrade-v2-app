{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "baseUrl": ".",
    "paths": {
      "@statstrade/edge/lib/js/net/conn-postgres.js": [
        "./src/browser-optional-backend.js"
      ],
      "@statstrade/edge/lib/js/net/conn-sqlite.js": [
        "./src/browser-optional-backend.js"
      ],
      "react-native": [
        "react-native-web"
      ],
      "@statstrade/web-main/*": [
        "./src/*"
      ],
      "@statstrade/component/*": [
        "../../packages/component/src/*"
      ],
      "@statstrade/config/*": [
        "../../packages/config/src/*"
      ],
      "@statstrade/edge/*": [
        "../../packages/edge/src/*"
      ],
      "@statstrade/feature/*": [
        "../../packages/feature/src/*"
      ],
      "@statstrade/group": [
        "../../packages/group/src"
      ],
      "@statstrade/group/*": [
        "../../packages/group/src/*"
      ]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".next-model-test/types/**/*.ts",
    ".next-real-data/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
